{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/vamsivoleti25/traveldeal_search/schema/card.schema.json",
  "title": "Credit card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "issuer",
    "type",
    "network",
    "annualFee",
    "currency",
    "baseRate",
    "earn",
    "credits",
    "lastVerified",
    "needsVerification",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "issuer": {
      "enum": [
        "chase",
        "amex",
        "capital_one",
        "citi",
        "bank_of_america",
        "wells_fargo",
        "us_bank",
        "barclays",
        "discover",
        "bilt",
        "apple",
        "other"
      ]
    },
    "network": {
      "enum": [
        "visa",
        "mastercard",
        "amex",
        "discover"
      ]
    },
    "annualFee": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string"
    },
    "baseRate": {
      "type": "number",
      "minimum": 0
    },
    "portal": {
      "enum": [
        "chase_travel",
        "amex_travel",
        "capital_one_travel",
        "citi_travel",
        "us_bank_travel",
        "bilt_travel"
      ]
    },
    "earn": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "categories",
          "channel",
          "rate"
        ],
        "properties": {
          "categories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/category"
            }
          },
          "channel": {
            "$ref": "#/definitions/ruleChannel"
          },
          "rate": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "prepaidOnly": {
            "type": "boolean"
          },
          "merchant": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "cap": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "capPeriod": {
            "enum": [
              "billing_cycle",
              "month",
              "quarter",
              "calendar_year",
              "anniversary_year"
            ]
          },
          "validFrom": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "validUntil": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "condition": {
            "type": "string"
          }
        }
      }
    },
    "credits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "amount",
          "period",
          "categories",
          "channel",
          "creditedAmountEarnsPoints"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "period": {
            "enum": [
              "calendar_year",
              "anniversary_year",
              "semiannual",
              "quarterly"
            ]
          },
          "categories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/category"
            }
          },
          "channel": {
            "$ref": "#/definitions/ruleChannel"
          },
          "minSpend": {
            "type": "number",
            "minimum": 0
          },
          "requiresTag": {
            "type": "string"
          },
          "creditedAmountEarnsPoints": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          },
          "merchant": {
            "type": "string"
          },
          "maxPerBooking": {
            "type": "number",
            "minimum": 0
          },
          "minNights": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "lastVerified": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "needsVerification": {
      "type": "boolean"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^https://"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "type": {
      "enum": [
        "personal",
        "business"
      ]
    },
    "foreignTransactionFee": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 5,
      "description": "Percent added to purchases charged in a foreign currency. null = not verified."
    },
    "checkedBags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program",
        "bags",
        "companions",
        "requiresPurchaseWithCard"
      ],
      "properties": {
        "program": {
          "type": "string"
        },
        "bags": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "companions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "requiresPurchaseWithCard": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "rentalCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "primary",
            "secondary"
          ]
        },
        "maxDaysHome": {
          "type": "integer"
        },
        "maxDaysAbroad": {
          "type": "integer"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "freeNight": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "program",
          "basis"
        ],
        "properties": {
          "program": {
            "type": "string"
          },
          "basis": {
            "enum": [
              "annual",
              "spend"
            ]
          },
          "capPoints": {
            "type": "integer"
          },
          "capCategory": {
            "type": "string"
          },
          "spendThreshold": {
            "type": "number"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "definitions": {
    "category": {
      "enum": [
        "flight",
        "hotel",
        "car_rental",
        "vacation_rental",
        "cruise",
        "attraction",
        "travel",
        "everything",
        "dining",
        "grocery",
        "gas",
        "online_retail",
        "office_supply",
        "drugstore",
        "wholesale_club",
        "home_improvement",
        "transit",
        "rideshare",
        "streaming",
        "entertainment",
        "phone_internet",
        "advertising",
        "shipping",
        "fitness",
        "rent",
        "foreign",
        "other"
      ]
    },
    "ruleChannel": {
      "oneOf": [
        {
          "enum": [
            "any",
            "direct",
            "portal",
            "ota"
          ]
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "direct",
              "portal",
              "ota"
            ]
          }
        }
      ]
    }
  }
}
