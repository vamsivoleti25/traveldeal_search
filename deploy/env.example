# Copy to deploy/.env on the VM:  cp deploy/env.example deploy/.env && chmod 600 deploy/.env
# Never commit deploy/.env. Defaults below are for personal mode (docs/PERSONAL_SETUP.md).

# Who may sign in (comma-separated Google emails). Anyone else sees "this server is private"
# and nothing about them is stored. Leave empty only if you really want open sign-up.
ALLOWED_EMAILS=you@gmail.com

# Stage 1 (private, SSH tunnel): leave empty.
# Stage 2 (public HTTPS): set to "public" and set DOMAIN, then run deploy/compose.sh up -d
COMPOSE_PROFILES=
DOMAIN=traveldeal.example.com

# Nightly backups to Object Storage (uses the VM's instance principal; no API keys)
BACKUP_BUCKET=traveldeal-backups
BACKUP_PREFIX=traveldeal

# GitHub repo the update timer deploys from
GITHUB_REPO=vamsivoleti25/traveldeal_search

# --- Optional: Autonomous Database instead of SQLite ------------------------------------
# Personal mode stores data in SQLite on the VM (docker volume traveldeal_db). Uncomment
# these to switch to the Always Free Autonomous Database; see docs/SYSTEM_DESIGN.md.
# ORACLE_USER=TRAVELDEAL
# ORACLE_PASSWORD=change-me
# ORACLE_DSN=(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1521)(host=adb.REGION.oraclecloud.com))(connect_data=(service_name=XXXX_traveldeal_tp.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))
